# All optional. Copy to .env in the repo root; `pnpm start` and `pnpm dev` read it.

# Port for the server (the built frontend is served from the same port).
PORT=4310

# Where lessons and the SQLite database live. Default: ~/.derive
# DERIVE_DATA_DIR=/home/you/.derive

# Model for the active provider. Leave unset to pick one in Settings or take
# the provider's own default.
# DERIVE_MODEL=claude-opus-5-5

# Which provider teaches is set in Settings (/settings in the app) and resolves
# on every turn as: the environment, then what Settings stored, then what was
# detected (a logged-in Claude Code or Codex, a local server on its port).
# A variable set here locks its field in Settings, and the page names the
# variable to unset.

# The app's tutor: "claude" (the Claude Agent SDK on your Claude Code login)
# or "codex" (the Codex SDK on your ChatGPT login). Unset lets Settings choose.
# DERIVE_BACKEND=claude

# A codex binary to use instead of the one bundled with the SDK.
# DERIVE_CODEX_BIN=/usr/local/bin/codex

# Provider keys. Each one locks its row's key field in Settings while it is set.
# Keys pasted in the app live in <data dir>/secrets.json (mode 0600), never in
# the database.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# The Gemini row reads GOOGLE_API_KEY first, then GEMINI_API_KEY.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# Web search, for the providers that have none of their own: OpenRouter, an
# OpenAI-compatible endpoint, and Gemini on a model older than 3. Anthropic,
# OpenAI and Gemini 3 search with their own tool and need nothing here. The
# choice is made in Settings (the "web search" block); this variable locks that
# key field while it is set, and the page names it to unset. The other choice,
# SearXNG, needs an address rather than a key, and that is set in Settings only.
# TAVILY_API_KEY=

# Prices for the cost figure on a lesson come from a table shipped with Derive.
# To use your own, put them in <data dir>/prices.json: it is read on each lesson
# (cached for a second) and merged over the shipped table, so only the models you
# name change. A file that cannot be read changes nothing and says so in
# Settings. There is no environment variable for it.

# Where Ollama listens, as Ollama's own CLI reads it (a host, host:port or URL).
# Default: 127.0.0.1:11434. Locks the Ollama row's address in Settings.
# OLLAMA_HOST=127.0.0.1:11434

# What an Ollama turn asks for on `think`: false (the default) or low | medium
# | high. Reasoning reaches neither the learner nor the database, so a lesson
# pays nothing for it by default. `pnpm conformance --think low` sets this for
# its own run, which is how the question of whether a model keeps calling tools
# with thinking off gets answered on a real server. Settings has no field for it.
# DERIVE_OLLAMA_THINK=false

# Reasoning effort: low | medium | high | xhigh | max. Default: high
# DERIVE_EFFORT=high

# Obsidian vault folder. When set, every lesson is mirrored there live as a
# markdown note while it happens, and "To vault" in a lesson rewrites it.
# DERIVE_VAULT_DIR=/home/you/vault/learning

# Which learner profile the Claude Code plugin uses, by name. Default: the
# first learner (named after your OS user). Create more from the switcher in
# the app, or with the plugin's `learners` tool.
# DERIVE_LEARNER=Ana

# Where a Claude Code lesson is answered: "browser" (cards block until you
# answer in the companion page) or "terminal" (cards are printed in the
# terminal and you reply there). Default: browser. `/derive:learn ... --terminal`
# overrides it per lesson.
# DERIVE_ANSWER_IN=terminal

# Which interface the server answers on. Default: 127.0.0.1 (this machine only).
# Setting it wider is opt-in and is announced loudly at startup. The Host header
# is checked against the address each request actually arrived on, so a request
# from the network naming 127.0.0.1 is still refused. Every browser, on this
# machine as well as on another device, opens the page once as
# http://<this machine>:4310/?token=<the token in <data dir>/token> — the
# startup line prints that link — and holds a cookie for 30 days after that;
# opening the same link again signs it in for another 30, and deleting the
# token file signs every browser out within a second, without restarting
# derive. Everything else sends the same token as the x-derive-token header,
# either way.
# DERIVE_HOST=0.0.0.0

# Extra browser origins allowed to call the API, comma-separated. Only needed
# when DERIVE_HOST is widened and you open the app from another device.
# DERIVE_ORIGINS=http://192.168.1.20:4310
