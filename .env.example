# All optional. Copy to .env in the repo root; `pnpm start` and `pnpm dev` read it.

# Port for the server (the built frontend is served from the same port).
PORT=4310

# Where lessons and the SQLite database live. Default: ~/.derive
# DERIVE_DATA_DIR=/home/you/.derive

# Model override. Leave unset to use your Claude Code default model.
# DERIVE_MODEL=claude-opus-5

# Reasoning effort: low | medium | high | xhigh | max. Default: high
# DERIVE_EFFORT=high

# Obsidian vault folder. When set, every lesson is mirrored there live as a
# markdown note while it happens, and "To vault" in a lesson rewrites it.
# DERIVE_VAULT_DIR=/home/you/vault/learning

# Which learner profile the Claude Code plugin uses, by name. Default: the
# first learner (named after your OS user). Create more from the switcher in
# the app, or with the plugin's `learners` tool.
# DERIVE_LEARNER=Ana

# Where a Claude Code lesson is answered: "browser" (cards block until you
# answer in the companion page) or "terminal" (cards are printed in the
# terminal and you reply there). Default: browser. `/derive:learn ... --terminal`
# overrides it per lesson.
# DERIVE_ANSWER_IN=terminal
